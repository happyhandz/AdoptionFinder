# Free key: https://rescuegroups.org/services/adoptable-pet-data-api/
RESCUEGROUPS_API_KEY=
# Phone access: run  python -m app.phone_setup  (generates the token and sets HOST=0.0.0.0). The app refuses to
# listen on the network without a token of at least 20 characters.
API_TOKEN=
HOST=127.0.0.1
PORT=8000
# Default refresh interval; can also be changed live from the UI (stored in the database)
POLL_MINUTES=30
DEFAULT_LOCATION=98031
DEFAULT_RADIUS=50
# Set to 1 to use fake sample dogs (no API key needed)
DEMO=0
